describe("Gerenciamento de usuários", () => {
  it("Dado que existem usuários cadastrados, quando eu consultar /users, então devem ser retornados 10 usuários com os campos obrigatórios", () => {
    cy.request("/users").then((res) => {
      expect(res.status).to.eq(200);
      expect(res.body).to.be.an("array").and.have.length(10);
      expect(res.body[0]).to.have.all.keys("id", "name", "username", "email", "address", "phone", "website", "company");
    });
  });

  it("Dado que o usuário 1 existe, quando eu consultar /users/1, então deve ser retornado o usuário com id 1", () => {
    cy.request("/users/1").then((res) => {
      expect(res.status).to.eq(200);
      expect(res.body.id).to.eq(1);
    });
  });

  it("Dado que o usuário 0 não existe, quando eu consultar /users/0, então deve retornar status 404", () => {
    cy.request({ url: "/users/0", failOnStatusCode: false }).then((res) => {
      expect(res.status).to.eq(404);
    });
  });

  it("Dado que o id tem letra, quando eu consultar /users/abc, então deve retornar status 404", () => {
    cy.request({ url: "/users/abc", failOnStatusCode: false }).then((res) => {
      expect(res.status).to.eq(404);
    });
  });

